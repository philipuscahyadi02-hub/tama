{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "module": "node16",
    "target": "es2022",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "types": ["node"]
  },
  "include": ["src/main/**/*.js", "src/preload/**/*.js", "src/shared/**/*.js", "scripts/**/*.js"]
}
