{
  "name": "tama",
  "productName": "Tama",
  "version": "0.0.0",
  "description": "Tama - a chibi anime agentic tamagotchi desktop companion",
  "author": "philipuscahyadi02-hub",
  "main": "src/main/index.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "tsc -p jsconfig.json && node --test",
    "test": "node --test",
    "changelog": "node scripts/changelog.js",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "dev.tama.app",
    "productName": "Tama",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "package.json",
      "!src/**/*.test.js",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk/**"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Tama-${version}-portable.exe"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  }
}
